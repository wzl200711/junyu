/* pages/login/login.wxss */
.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #10b981 0%, #f4f6f5 36%);
  padding: 0 48rpx;
}

.login-header {
  text-align: center;
  padding: 120rpx 0 60rpx;
}
.logo {
  width: 140rpx;
  height: 140rpx;
  margin: 0 auto 24rpx;
  border-radius: 36rpx;
  background: #fff;
  color: #10b981;
  font-size: 80rpx;
  font-weight: 700;
  line-height: 140rpx;
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.25);
}
.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
}
.subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
}

.login-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.input-row {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #f0f0f0;
  padding: 24rpx 8rpx;
}
.input-label {
  width: 80rpx;
  color: #6b7280;
  font-size: 28rpx;
}
.login-input {
  flex: 1;
  font-size: 30rpx;
  color: #1f2937;
}

.login-btn {
  margin-top: 48rpx;
  height: 88rpx;
  font-size: 32rpx;
}

.switch-mode {
  text-align: center;
  color: #10b981;
  font-size: 26rpx;
  margin-top: 28rpx;
  padding: 12rpx;
}
