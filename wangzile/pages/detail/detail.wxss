/* pages/detail/detail.wxss */
.page-scroll { height: 100vh; }

.detail-img {
  width: 100%;
  height: 600rpx;
  background: #f4f6f5;
  display: block;
}
.detail-img-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9ca3af;
}

.detail-info {
  background: #fff;
  padding: 32rpx;
  margin-top: -24rpx;
  border-radius: 32rpx 32rpx 0 0;
  position: relative;
}
.detail-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2937;
}
.detail-price-row {
  display: flex;
  align-items: center;
  margin: 16rpx 0;
}
.detail-price { font-size: 48rpx; }

.tag {
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  margin-left: 16rpx;
}
.tag-orange { background: #fef3c7; color: #d97706; }
.tag-gray { background: #f3f4f6; color: #6b7280; }

.detail-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.seller-link {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #4b5563;
}
.seller-avatar {
  margin-right: 12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 22rpx;
}
.detail-views { font-size: 24rpx; color: #9ca3af; }

.detail-desc-title {
  font-size: 28rpx;
  font-weight: 600;
  margin: 24rpx 0 12rpx;
}
.detail-desc {
  font-size: 28rpx;
  color: #4b5563;
  line-height: 1.6;
}

.detail-action { margin-top: 32rpx; }
.detail-action .btn { margin-bottom: 16rpx; }

.section-title {
  padding: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.product-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 12rpx;
}
.product-card {
  width: 348rpx;
  margin: 12rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.p-img {
  width: 100%;
  height: 260rpx;
  background: #f4f6f5;
  display: block;
}
.p-img-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9ca3af;
  font-size: 24rpx;
}
.p-body { padding: 16rpx; }
.p-name {
  font-size: 26rpx;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
