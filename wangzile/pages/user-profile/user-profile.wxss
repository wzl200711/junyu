/* pages/user-profile/user-profile.wxss */
.page-scroll { height: 100vh; }

.hero {
  padding: 60rpx 32rpx 40rpx;
  background: linear-gradient(135deg, #10b981, #059669);
  text-align: center;
}
.hero-inner {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
}
.hero-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.5);
  overflow: hidden;
  margin-bottom: 16rpx;
  background: #fff;
}
.hero-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}
.hero-bio {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin: 12rpx 0 20rpx;
}

.section-title {
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #4b5563;
}
.product-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 12rpx;
}
.product-card {
  width: 348rpx;
  margin: 12rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.p-img {
  width: 100%;
  height: 260rpx;
  background: #f4f6f5;
  display: block;
}
.p-img-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9ca3af;
  font-size: 24rpx;
}
.p-body { padding: 16rpx; }
.p-name {
  font-size: 28rpx;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.p-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.p-views { font-size: 22rpx; color: #9ca3af; }
.p-cat { font-size: 22rpx; color: #9ca3af; margin-top: 8rpx; }

/* 短视频分享网格 */
.video-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 12rpx;
}
.video-cell {
  width: calc(33.33% - 24rpx);
  margin: 12rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}
.v-thumb {
  width: 100%;
  height: 220rpx;
  background: #f4f6f5;
  display: block;
}
.v-thumb-video {
  display: flex;
  align-items: center;
  justify-content: center;
}
.v-play {
  font-size: 56rpx;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.5);
}
.v-likes {
  position: absolute;
  bottom: 8rpx;
  left: 8rpx;
  font-size: 22rpx;
  color: #fff;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.5);
}
