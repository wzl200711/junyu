/* pages/videos/videos.wxss - 短视频流 */
.video-page {
  height: 100vh;
  background: #000;
  position: relative;
}

.back-btn {
  position: fixed;
  top: 60rpx;
  left: 24rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.4);
  color: #fff;
  font-size: 48rpx;
  line-height: 64rpx;
  text-align: center;
  z-index: 50;
}

.video-swiper { height: 100vh; }
.video-card {
  width: 100%;
  height: 100vh;
  position: relative;
}
.video-media {
  width: 100%;
  height: 100vh;
}

.video-overlay {
  position: absolute;
  bottom: 220rpx;
  left: 24rpx;
  right: 120rpx;
}
.video-desc {
  color: #fff;
  font-size: 28rpx;
  line-height: 1.5;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.5);
}

.video-side {
  position: absolute;
  right: 16rpx;
  bottom: 260rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 36rpx;
}
.video-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  border: 4rpx solid #fff;
}
.side-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.side-icon { font-size: 56rpx; }
.side-count {
  color: #fff;
  font-size: 22rpx;
  margin-top: 4rpx;
}

.video-bottom {
  position: absolute;
  bottom: 60rpx;
  left: 24rpx;
}
.video-user {
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.5);
}
.video-time {
  color: rgba(255, 255, 255, 0.7);
  font-size: 22rpx;
  margin-top: 4rpx;
}

.pub-fab {
  position: fixed;
  right: 32rpx;
  bottom: 160rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #10b981, #059669);
  color: #fff;
  font-size: 56rpx;
  line-height: 96rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.4);
  z-index: 100;
}
.pub-btn { margin-top: 16rpx; }

/* 评论弹窗 */
.comment-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}
.comment-panel {
  width: 100%;
  max-height: 70vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
}
.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-bottom: 1rpx solid #f0f0f0;
}
.close-btn { color: #9ca3af; font-size: 36rpx; }
.comment-list {
  flex: 1;
  max-height: 50vh;
  padding: 16rpx 24rpx;
}
.comment-empty {
  text-align: center;
  color: #9ca3af;
  padding: 40rpx;
}
.comment-item {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}
.comment-main { flex: 1; margin-left: 16rpx; }
.comment-name {
  font-size: 26rpx;
  color: #10b981;
  font-weight: 500;
}
.comment-text {
  font-size: 28rpx;
  color: #1f2937;
  margin: 4rpx 0;
  word-break: break-all;
}
.comment-time {
  font-size: 22rpx;
  color: #9ca3af;
}
.comment-input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
}
.comment-input {
  flex: 1;
  background: #f4f6f5;
  border-radius: 999rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  margin-right: 16rpx;
}
