/* pages/public/public.wxss - 聊天大厅 */
.public-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f4f6f5;
}

/* 顶部切换 tab */
.pub-tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}
.pub-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #6b7280;
}
.pub-tab.active {
  color: #10b981;
  font-weight: 600;
  border-bottom: 4rpx solid #10b981;
}
.pub-msg-list {
  flex: 1;
  padding: 24rpx 16rpx;
}
/* 微信群聊气泡行 */
.pub-msg-row {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}
.pub-mine {
  flex-direction: row-reverse;
}
.pub-avatar {
  width: 72rpx;
  height: 72rpx;
  font-size: 32rpx;
  flex-shrink: 0;
}
.pub-msg-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  max-width: 78%;
}
.pub-mine .pub-msg-content {
  align-items: flex-end;
}
.pub-msg-meta {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
  gap: 8rpx;
  padding: 0 8rpx;
}
.pub-msg-name {
  font-size: 24rpx;
  color: #6b7280;
}
.pub-msg-time {
  font-size: 20rpx;
  color: #9ca3af;
}
.pub-bubble {
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
  background: #fff;
  color: #1f2937;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  margin: 0 16rpx;
}
.pub-mine .pub-bubble {
  background: #95ec75;
}
.pub-product {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: rgba(16, 185, 129, 0.08);
  border-radius: 8rpx;
  color: #10b981;
  font-size: 26rpx;
}
.pub-input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
}
.pub-input {
  flex: 1;
  background: #f4f6f5;
  border-radius: 999rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  margin-right: 12rpx;
}

/* 头像(大厅用) */
.pub-avatar {
  width: 48rpx;
  height: 48rpx;
  font-size: 24rpx;
  flex-shrink: 0;
}

/* 消息里的图片 / 视频 */
.pub-msg-image {
  width: 100%;
  max-width: 400rpx;
  border-radius: 12rpx;
  margin-top: 12rpx;
  display: block;
}
.pub-msg-video {
  width: 100%;
  max-width: 400rpx;
  border-radius: 12rpx;
  margin-top: 12rpx;
}

/* 输入栏图标按钮 */
.pub-icon-btn {
  font-size: 40rpx;
  padding: 0 8rpx;
  line-height: 1;
  display: flex;
  align-items: center;
}
.pub-send-btn {
  flex-shrink: 0;
}

