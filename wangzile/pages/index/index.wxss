/* pages/index/index.wxss */
.page {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
}
.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f4f6f5;
  border-radius: 999rpx;
  padding: 0 24rpx;
  height: 64rpx;
}
.search-icon { font-size: 26rpx; opacity: 0.6; }
.search-input {
  flex: 1;
  margin: 0 16rpx;
  font-size: 26rpx;
}
.clear-btn {
  color: #9ca3af;
  font-size: 28rpx;
  padding: 0 8rpx;
}
.search-btn {
  margin-left: 16rpx;
  color: #10b981;
  font-size: 28rpx;
  padding: 0 8rpx;
}

/* 广告轮播 */
.ad-swiper {
  width: 100%;
  height: 200rpx;
}
.ad-item {
  width: 100%;
  height: 200rpx;
  padding: 12rpx 24rpx;
  box-sizing: border-box;
}
.ad-img {
  width: 100%;
  height: 176rpx;
  border-radius: 16rpx;
  background: #f4f6f5;
}

/* 分类(全展示, 自动换行) */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  gap: 12rpx;
}
.cat-item {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #f4f6f5;
  color: #6b7280;
  font-size: 24rpx;
}
.cat-item.active {
  background: linear-gradient(135deg, #10b981, #059669);
  color: #fff;
}

/* 大家都在看 */
.hot-section {
  margin: 16rpx 0;
  background: #fff;
  padding: 16rpx 0;
}
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx 12rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}
.section-desc {
  font-size: 22rpx;
  color: #9ca3af;
}
.hot-scroll {
  white-space: nowrap;
  padding: 0 16rpx;
}
.hot-card {
  display: inline-block;
  width: 180rpx;
  margin: 0 8rpx;
  vertical-align: top;
}
.hot-img, .hot-img-ph {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: #f4f6f5;
}
.hot-img-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.85);
  font-size: 56rpx;
  font-weight: 600;
}
.hot-name {
  font-size: 24rpx;
  color: #1f2937;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hot-price {
  font-size: 24rpx;
  color: #ef4444;
  font-weight: 600;
  margin-top: 4rpx;
}

/* 商品网格(一排四个) */
.goods-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx 16rpx;
  gap: 12rpx;
}
.goods-card {
  width: calc(25% - 9rpx);
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.goods-img-box {
  width: 100%;
  height: 165rpx;
}
.goods-img {
  width: 100%;
  height: 165rpx;
  background: #f4f6f5;
  display: block;
}
.goods-img-ph {
  width: 100%;
  height: 165rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ph-text {
  color: rgba(255, 255, 255, 0.85);
  font-size: 48rpx;
  font-weight: 600;
}
.goods-info { padding: 8rpx 10rpx 10rpx; }
.goods-name {
  font-size: 22rpx;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.3;
  min-height: 58rpx;
}
.goods-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 6rpx;
}
.goods-price {
  color: #ef4444;
  font-weight: 600;
  font-size: 24rpx;
}

/* 发布按钮 */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 160rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #10b981, #059669);
  color: #fff;
  font-size: 56rpx;
  line-height: 96rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.4);
  z-index: 100;
}
