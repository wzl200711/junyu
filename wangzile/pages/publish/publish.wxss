/* pages/publish/publish.wxss */
.page-scroll {
  height: 100vh;
  padding: 24rpx;
}

.form-group {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.form-label {
  font-size: 28rpx;
  color: #6b7280;
  margin-bottom: 16rpx;
}

.image-picker {
  width: 100%;
  height: 360rpx;
  background: #f4f6f5;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #d1d5db;
}
.picked-img {
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
}
.image-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #9ca3af;
  font-size: 26rpx;
}
.ip-icon {
  font-size: 64rpx;
  color: #10b981;
  margin-bottom: 8rpx;
}
.clear-img {
  margin-top: 16rpx;
  align-self: flex-start;
}

.form-input {
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  background: #fff;
}
.form-textarea {
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  width: 100%;
  height: 200rpx;
  background: #fff;
  box-sizing: border-box;
}
.picker-val {
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  background: #fff;
}

.submit-btn {
  margin-top: 32rpx;
  height: 88rpx;
  font-size: 32rpx;
}
