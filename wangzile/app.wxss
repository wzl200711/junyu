/* app.wxss - 全局样式(骏宇超市 / 清新绿主题) */

view, text, input, textarea, scroll-view, swiper, button, navigator, image {
  box-sizing: border-box;
}

page {
  background: #f4f6f5;
  color: #1f2937;
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

/* 通用容器 */
.container {
  padding: 24rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(16, 185, 129, 0.06);
}

/* 按钮基础 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 1.4;
  border: none;
}
.btn::after { border: none; }

.btn-primary {
  background: linear-gradient(135deg, #10b981, #059669);
  color: #fff;
}

.btn-outline {
  background: #fff;
  color: #10b981;
  border: 2rpx solid #10b981;
}

.btn-block {
  display: flex;
  width: 100%;
}

.btn-danger {
  background: #fee2e2;
  color: #dc2626;
}

/* 文本辅助 */
.text-muted { color: #9ca3af; }
.text-primary { color: #10b981; }
.text-danger { color: #dc2626; }
.text-sm { font-size: 24rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 40rpx; font-weight: 600; }
.text-bold { font-weight: 600; }
.text-center { text-align: center; }

/* 价格 */
.price { color: #ef4444; font-weight: 600; }

/* 头像圆圈 */
.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

/* flex 工具 */
.flex { display: flex; }
.flex-1 { flex: 1; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-col { display: flex; flex-direction: column; }

/* 分隔 */
.divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 20rpx 0;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #9ca3af;
}
.empty-icon {
  font-size: 96rpx;
  margin-bottom: 16rpx;
  opacity: 0.5;
}

/* 小按钮 / 成功按钮 */
.btn-small { padding: 10rpx 24rpx; font-size: 24rpx; }
.btn-success { background: linear-gradient(135deg, #22c55e, #16a34a); color: #fff; }

/* 标签 */
.tag {
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  display: inline-block;
}
.tag-green { background: #d1fae5; color: #059669; }
.tag-orange { background: #fef3c7; color: #d97706; }
.tag-gray { background: #f3f4f6; color: #6b7280; }

/* 头像图片填充 */
.avatar-img { width: 100%; height: 100%; border-radius: 50%; display: block; }

/* 页面滚动容器 */
.page-scroll { height: 100vh; }

